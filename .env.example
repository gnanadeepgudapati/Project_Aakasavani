# Copy to .env and fill in. .env itself is gitignored - never commit real
# values. See BLOCKED.md B-002 for what each is for and where to get it.

# Research panel (steps 14-17). Paid, ~$5-6/month. console.anthropic.com
ANTHROPIC_API_KEY=

# Internet Archive Save Page Now (step 11). Free. archive.org/account/s3.php
IA_S3_ACCESS_KEY=
IA_S3_SECRET_KEY=

# Deep history, Guardian Open Platform (step 20). Free, 5k calls/day.
# open-platform.theguardian.com/access
GUARDIAN_API_KEY=

# Caddy HTTP basic auth (deploy only). Choose your own.
AAKASAVANI_PASSWORD=
